<form class="editor-grid" data-api-form data-dirty action="/api/admin/about" data-method="PUT" enctype="multipart/form-data"><section class="panel"><div class="form-feedback" role="alert" hidden></div><h2>Profil toko</h2><p class="panel-description">Sumber konten profil lengkap, foto toko, dan ringkasan di Home.</p><% for(const[key,label,min,max,rows]of[['title','Judul',3,120,0],['home_summary','Ringkasan Home',20,350,3],['description','Deskripsi lengkap',20,10000,10]]){ %><div class="field"><label for="<%= key %>"><%= label %> <span>*</span></label><% if(rows){ %><textarea id="<%= key %>" name="<%= key %>" rows="<%= rows %>" minlength="<%= min %>" maxlength="<%= max %>" required><%= about[key] %></textarea><% }else{ %><input id="<%= key %>" name="<%= key %>" value="<%= about[key] %>" minlength="<%= min %>" maxlength="<%= max %>" required><% } %><span class="field-error" data-error="<%= key %>"></span></div><% } %><button class="button primary" type="submit">Simpan Perubahan</button></section><section class="panel photo-panel"><h2>Foto toko</h2><p class="panel-description">Opsional. JPG, PNG, atau WebP maksimal 5 MB.</p><div class="upload-preview"><img data-preview <%- about.image_asset_id?'src="/media/'+about.image_asset_id+'"':'hidden' %> alt="Preview foto toko"><span data-preview-empty <%= about.image_asset_id?'hidden':'' %>>▧<small>Belum ada foto</small></span></div><label for="image" class="upload-label">Pilih / Ganti Foto</label><input type="file" id="image" name="image" accept="image/jpeg,image/png,image/webp" data-photo><span class="field-error" data-error="image"></span></section></form>
