<section class="container content-page"><div class="section-heading page-intro"><div><span class="eyebrow"><span data-i18n="ready">KAMI SIAP MEMBANTU</span></span><h1><span data-i18n="connect">Cek ketersediaan produk</span><span class="red-dot">.</span></h1></div><p class="lead"><span data-i18n="contactIntro">Hubungi TractorPart untuk mengecek stok suku cadang yang Anda butuhkan.</span></p></div><div class="contact-layout"><div class="contact-primary"><span class="eyebrow"><span data-i18n="stockLabel">KETERSEDIAAN PRODUK</span></span><h2><span data-i18n="stockTitleLead">Pastikan</span><br><span data-i18n="stockTitleEnd">stok produk.</span></h2><% if(contact.whatsapp){ %><p>+<%= contact.whatsapp %></p><a class="button primary" href="<%= whatsapp(contact) %>"><span data-i18n="whatsapp">Chat melalui WhatsApp</span> <span class="inline-arrow"><%- include('arrow',{direction:'up-right'}) %></span></a><% }else{ %><p class="placeholder-text"><span data-i18n="missingWhatsApp">[Placeholder] Nomor WhatsApp belum diisi oleh pengelola.</span></p><% } %></div><div class="contact-data"><div><span class="eyebrow"><span data-i18n="address">ALAMAT TOKO</span></span><p class="preserve-lines" translate="no"><%= contact.address %></p><% if(contact.maps_url){ %><a class="text-link" href="<%= contact.maps_url %>" target="_blank" rel="noopener noreferrer"><span data-i18n="maps">Buka Peta</span><span class="inline-arrow"><%- include('arrow',{direction:'up-right'}) %></span></a><% } %></div><div><span class="eyebrow"><span data-i18n="hours">JAM OPERASIONAL</span></span><p class="preserve-lines" translate="no"><%= contact.opening_hours %></p></div><% if(contact.phone||contact.email){ %><div><span class="eyebrow"><span data-i18n="otherContact">KONTAK LAINNYA</span></span><% if(contact.phone){ %><a href="tel:+<%= contact.phone %>">+<%= contact.phone %></a><% } %><% if(contact.email){ %><a href="mailto:<%= contact.email %>"><%= contact.email %></a><% } %></div><% } %><% if(contact.links.length){ %><div><span class="eyebrow"><span data-i18n="follow">IKUTI KAMI</span></span><div class="social-links"><% for(const link of contact.links){ %><a class="text-link" href="<%= link.url %>" target="_blank" rel="noopener noreferrer" translate="no"><%= link.name %></a><% } %></div></div><% } %></div></div></section>