<!doctype html>
<html lang="id" data-input-mode="pointer">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %> · TractorPart</title><meta name="description" content="<%= description %>">
  <% if(page.startsWith('admin')||page==='login'){ %><meta name="robots" content="noindex,nofollow"><% } else { %><link rel="canonical" href="<%= baseUrl + currentPath %>"><% } %>
  <meta property="og:title" content="<%= title %> · TractorPart"><meta property="og:description" content="<%= description %>"><meta property="og:type" content="<%= page==='detail'?'product':'website' %>"><meta property="og:url" content="<%= baseUrl+currentPath %>">
  <% if(page==='detail'){ %><meta property="og:image" content="<%= baseUrl %>/media/<%= product.image_asset_id %>"><% } %>
  <meta name="csrf-token" content="<%= csrf %>">
  <link rel="icon" type="image/png" sizes="64x64" href="/static/favicon.png?v=rounded-2">
  <link rel="stylesheet" href="<%= webAssets.css %>">
  <script src="<%= page.startsWith('admin')?webAssets.admin:page==='login'?webAssets.login:webAssets.public %>" defer></script>
</head>
<body data-page="<%= page %>" class="<%= page.startsWith('admin')?'admin-body':page==='login'?'login-body':'public-body' %>">
<a class="skip-link" href="#main" data-i18n="skip">Lewati ke konten</a>
<% if(page.startsWith('admin')) { %>
  <div class="admin-shell">
  <aside class="sidebar"><a class="brand" href="<%= adminPath('/admin') %>"><img src="/static/images/logo.png" width="2172" height="724" alt="TractorPart"></a><div class="sidebar-label">RUANG PENGELOLA</div>
    <nav aria-label="Navigasi admin"><% for(const [url,label,symbol] of [['/admin','Dashboard','dashboard'],['/admin/products','Produk','engine'],['/admin/categories','Kategori','tag'],['/admin/about','Tentang','info'],['/admin/gallery','Galeri','image'],['/admin/contact','Kontak','phone']]) { const target=adminPath(url); const active=url==='/admin'?currentPath===target:currentPath.startsWith(target); %>
      <a class="<%= active?'active':'' %>" href="<%= target %>" <%- active?'aria-current="page"':'' %>><%- include('admin-icon',{name:symbol}) %><span><%= label %></span></a><% } %></nav>
    <div class="sidebar-bottom"><div class="admin-language" role="group" aria-label="Bahasa / Language"><button type="button" data-admin-language="id" aria-label="Bahasa Indonesia" aria-pressed="true">ID</button><button type="button" data-admin-language="en" aria-label="English" aria-pressed="false">EN</button></div><a href="/" target="_blank" rel="noopener"><span>Lihat Website</span><span class="inline-arrow"><%- include('arrow',{direction:'up-right'}) %></span></a><button class="logout" data-logout="<%= adminPreview?'/api/preview/logout':'/api/admin/logout' %>">Logout</button></div>
  </aside>
  <div class="admin-workspace"><header class="admin-topbar"><button class="menu-toggle" aria-label="Buka menu admin" aria-expanded="false" data-admin-menu>☰</button><span>Katalog & konten toko</span><div class="admin-identity" translate="no"><span class="avatar" aria-hidden="true"><%= adminIdentity.initials %></span><span><strong><%= adminIdentity.name %></strong><small><%= adminEmail %></small></span></div></header>
    <main id="main" class="admin-main"><div class="page-heading"><div><span class="eyebrow">TRACTORPART ADMIN</span><h1><%= title %></h1></div><% if(page==='admin-dashboard'||page==='admin-products'){ %><a class="button primary" href="<%= adminPath('/admin/products/new') %>">+ Tambah Produk</a><% } %></div>
    <% if(demo){ %><div class="notice">Lingkungan demo: produk dan ilustrasi bertanda dummy. Ganti dengan data asli sebelum peluncuran.</div><% } %>
    <% if(adminPreview){ %><div class="notice admin-preview-notice"><strong>Preview Admin</strong><span>Data contoh. Mode lihat saja; perubahan tidak disimpan.</span></div><fieldset disabled class="admin-preview-content" aria-label="Contoh tampilan admin"><%- include(page) %></fieldset><% }else{ %><%- include(page) %><% } %></main></div></div>
<% } else if(page==='login') { %>
  <main id="main" class="login-main"><%- include('login') %></main>
<% } else { %>
  <header class="site-header"><div class="header-inner">
    <button class="menu-toggle" aria-label="Buka menu navigasi" aria-expanded="false" aria-controls="mobile-menu" aria-haspopup="dialog" data-menu>☰</button>
    <nav class="site-nav" aria-label="Navigasi utama" data-i18n-aria="navigation"><% for(const [url,label] of [['/','Beranda'],['/products','Produk'],['/about','Tentang'],['/gallery','Galeri'],['/contact','Kontak']]){const active=url==='/'?currentPath===url:currentPath.startsWith(url);%><a href="<%= ({'/about':'/#tentang','/gallery':'/#galeri','/contact':'/#kontak'})[url] || url %>" data-i18n="<%= ({'/':'home','/products':'products','/about':'about','/gallery':'gallery','/contact':'contact'})[url] %>" data-section="<%= ({'/':'home','/products':'produk-terbaru','/about':'tentang','/gallery':'galeri','/contact':'kontak'})[url] %>" class="<%= active?'active':'' %>" <%- active?'aria-current="page"':'' %>><%= label %></a><% } %></nav>
    <a class="brand header-brand" href="/" aria-label="TractorPart Home"><img src="/static/images/logo.png" width="2172" height="724" alt="TractorPart"></a>
    <div class="header-actions"><div class="language-toggle" role="group" aria-label="Bahasa / Language"><button type="button" data-language="id" aria-label="Bahasa Indonesia" aria-pressed="true">ID</button><button type="button" data-language="en" aria-label="English" aria-pressed="false">EN</button></div><div class="mobile-language"><label for="mobile-language" class="sr-only" data-i18n="language">Bahasa</label><select id="mobile-language" data-custom-select data-language-select><option value="id" selected>ID</option><option value="en">EN</option></select></div><a class="button primary header-cta" aria-label="Hubungi Kami" data-i18n-aria="contactUs" href="<%= whatsapp(contact) %>"><span data-i18n="contactUs">Hubungi Kami</span><span class="header-phone" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" focusable="false"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.69 2.79a2 2 0 0 1-.45 2.11L8.09 9.89a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.89.33 1.83.56 2.79.69A2 2 0 0 1 22 16.92Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span></a></div></div></header>
  <%- include('mobile-menu') %>
  <div class="scroll-edge" aria-hidden="true"></div><main id="main"><%- include(page) %></main>
  <footer class="site-footer"><div class="footer-top container"><div><a class="brand" href="/"><img src="/static/images/logo.png" width="2172" height="724" alt="TractorPart"></a><p><span data-i18n="footerLine1">Suku cadang yang tepat.</span><br><span data-i18n="footerLine2">Untuk mesin yang terus bekerja.</span></p></div><nav aria-label="Navigasi footer" data-i18n-aria="footerNavigation"><% for(const [url,label] of [['/','Beranda'],['/products','Produk'],['/about','Tentang'],['/gallery','Galeri'],['/contact','Kontak']]){%><a href="<%= ({'/about':'/#tentang','/gallery':'/#galeri','/contact':'/#kontak'})[url] || url %>" data-i18n="<%= ({'/':'home','/products':'products','/about':'about','/gallery':'gallery','/contact':'contact'})[url] %>"><%= label %></a><%}%></nav><div class="footer-contact"><span class="eyebrow"><span data-i18n="findUs">TEMUKAN KAMI</span></span><p><%= contact.address %></p><% if(contact.whatsapp){%><a href="<%= whatsapp(contact) %>">+<%= contact.whatsapp %></a><%}%><% for(const phone of contact.phones){%><a href="tel:+<%= phone %>" translate="no">+<%= phone %></a><%}%><% if(contact.email){%><a href="mailto:<%= contact.email %>"><%= contact.email %></a><%}%><div class="external-links"><% for(const link of contact.links){ %><a href="<%= link.url %>" target="_blank" rel="noopener noreferrer" translate="no"><%= link.name %></a><% } %></div></div></div><div class="footer-bottom container"><span>© <%= new Date().getFullYear() %> <span data-i18n="rights">TractorPart. Hak cipta dilindungi.</span></span><span><span data-i18n="footerCatalog">Katalog suku cadang</span></span></div></footer>
<% } %>
<div id="toast" class="toast" role="status" aria-live="polite" hidden></div>
<dialog id="confirm-dialog" class="dialog"><form method="dialog"><span class="eyebrow">KONFIRMASI</span><h2>Hapus item?</h2><p id="confirm-message"></p><div class="form-actions"><button class="button" value="cancel">Batal</button><button class="button primary" value="confirm">Hapus</button></div></form></dialog>
<dialog id="category-dialog" class="dialog"><button class="dialog-close" data-close-dialog aria-label="Tutup dialog">×</button><span class="eyebrow">KATEGORI BARU</span><h2>Tambah Kategori</h2><form data-category-modal><div class="form-feedback" role="alert" hidden></div><label for="modal-category-name">Nama kategori</label><input id="modal-category-name" name="name" minlength="2" maxlength="80" required><span class="field-error" data-error="name"></span><button class="button primary" type="submit">Simpan Kategori</button></form></dialog>
<dialog id="lightbox" class="lightbox" aria-label="Foto galeri" data-i18n-aria="galleryPhoto"><button class="lightbox-close" data-lightbox-close aria-label="Tutup galeri" data-i18n-aria="closeGallery">×</button><button class="lightbox-prev" data-lightbox-prev aria-label="Foto sebelumnya" data-i18n-aria="prevPhoto"><%- include('arrow',{direction:'left'}) %></button><figure><img id="lightbox-image" alt=""><figcaption><span id="lightbox-counter"></span></figcaption></figure><button class="lightbox-next" data-lightbox-next aria-label="Foto berikutnya" data-i18n-aria="nextPhoto"><%- include('arrow',{direction:'right'}) %></button></dialog>
<% if(page.startsWith('admin')) { %><%- include('photo-crop') %><% } %>
</body></html>
