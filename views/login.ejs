<a class="brand" href="/"><img src="/static/images/logo.png" width="2172" height="724" alt="TractorPart"></a>
<div class="login-card">
  <span class="eyebrow">RUANG PENGELOLA</span><h1>Selamat datang<br>kembali.</h1>
  <p>Masuk untuk mengelola katalog dan konten toko.</p>
  <form data-api-form action="/api/login" method="post">
    <div class="form-feedback" role="alert" hidden></div>
    <div class="field"><label for="email">Email admin</label><input type="email" id="email" name="email" autocomplete="username" required></div>
    <div class="field">
      <label for="password">Password</label>
      <div class="password-field">
        <input type="password" id="password" name="password" autocomplete="current-password" required maxlength="1024">
        <button class="password-toggle" type="button" data-password-toggle aria-controls="password" aria-label="Tampilkan password" aria-pressed="false" hidden>
          <svg class="password-eye" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
          <svg class="password-eye-off" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m3 3 18 18M10.6 5.1A12 12 0 0 1 12 5c6.5 0 10 7 10 7a17 17 0 0 1-3.1 4.1M6.4 6.4A18 18 0 0 0 2 12s3.5 7 10 7a12 12 0 0 0 5.6-1.4M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg>
        </button>
      </div>
    </div>
    <button class="button primary wide" type="submit">Masuk</button>
  </form>
  <% if(adminPreviewAvailable){ %><a class="button wide admin-preview-button" href="/admin/preview"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg><span>Preview Admin</span></a><% } %>
</div>
