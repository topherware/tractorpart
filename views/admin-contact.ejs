<form class="panel contact-editor" data-api-form data-dirty action="/api/admin/contact" data-method="PUT"><div class="form-feedback" role="alert" hidden></div><h2>Informasi kontak</h2><p class="panel-description">Data yang sama digunakan oleh Contact, tombol WhatsApp, dan footer.</p><div class="form-row"><% for(const[key,label,type,required]of[['whatsapp','WhatsApp utama','tel',true],['phone','Telepon','tel',false],['email','Email','email',false]]){ %><div class="field"><label for="<%= key %>"><%= label %><%= required?' *':'' %></label><input id="<%= key %>" name="<%= key %>" type="<%= type %>" value="<%= contact[key] %>" <%= required?'required':'' %> maxlength="150"><span class="field-error" data-error="<%= key %>"></span><% if(type==='tel'){ %><small>Format 08, 62, atau +62.</small><% } %></div><% } %></div><div class="form-row"><% for(const[key,label,max]of[['address','Alamat toko',1000],['opening_hours','Jam operasional',500]]){ %><div class="field"><label for="<%= key %>"><%= label %> *</label><textarea id="<%= key %>" name="<%= key %>" rows="4" required maxlength="<%= max %>"><%= contact[key] %></textarea><span class="field-error" data-error="<%= key %>"></span></div><% } %></div><h2>Lokasi & tautan toko</h2><div class="field"><label for="maps_url">Tautan lokasi Maps</label><input type="url" id="maps_url" name="maps_url" value="<%= contact.maps_url %>" placeholder="https://..." maxlength="2048"><span class="field-error" data-error="maps_url"></span></div>
<h2>Platform & media sosial</h2><p class="panel-description">Tambahkan Tokopedia, Shopee, Instagram, atau platform lain. Isi nama dan URL HTTPS.</p>
<div data-contact-links><input type="hidden" name="links" value="<%= JSON.stringify(contact.links) %>" data-links-value><div data-link-rows></div><button class="button" type="button" data-add-link>+ Tambah Tautan</button><span class="field-error" data-error="links"></span></div>
<div class="contact-save-actions"><button class="button primary" type="submit">Simpan Perubahan</button></div></form>
