<div class="editor-grid"><section class="panel"><div class="panel-heading"><div><h2>Daftar kategori</h2><p>Kategori yang dipakai produk tidak dapat dihapus.</p></div></div><% categories.forEach(c=>{ %><div class="category-row"><form data-api-form data-dirty action="/api/admin/categories/<%= c.id %>" data-method="PUT" data-reload><div class="form-feedback" role="alert" hidden></div><label class="sr-only" for="category-<%= c.id %>">Nama kategori <%= c.name %></label><input id="category-<%= c.id %>" name="name" value="<%= c.name %>" required minlength="2" maxlength="80"><span class="field-error" data-error="name"></span><small><%= c.product_count %> produk terkait</small><div class="row-actions"><button class="mini-button" type="submit">Simpan</button><button class="mini-button danger" type="button" data-delete="/api/admin/categories/<%= c.id %>" data-name="<%= c.name %>">Hapus</button></div></form></div><% }) %><% if(!categories.length){ %><div class="empty-state"><h3>Belum ada kategori</h3><p>Buat kategori pertama di form sebelah.</p></div><% } %></section><section class="panel"><h2>Tambah kategori</h2><p class="panel-description">Nama unik. Slug dibuat otomatis.</p><form data-api-form data-dirty action="/api/admin/categories" data-method="POST" data-reload><div class="form-feedback" role="alert" hidden></div><div class="field"><label for="new-category">Nama kategori</label><input id="new-category" name="name" required minlength="2" maxlength="80"><span class="field-error" data-error="name"></span></div><button type="submit" class="button primary">Tambah Kategori</button></form></section></div>
