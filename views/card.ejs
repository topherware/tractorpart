<article class="product-card">
  <a class="product-image" href="/products/<%= p.slug %>" aria-label="Lihat <%= p.name %>"><img src="/media/<%= p.image_asset_id %>" alt="<%= p.name %>" width="<%= p.image_width||800 %>" height="<%= p.image_height||800 %>" loading="lazy"><span class="badge <%= p.availability==='available'?'available':'unavailable' %>"><span data-i18n="<%= p.availability==='available'?'available':'unavailable' %>"><%= p.availability==='available'?'Tersedia':'Habis' %></span></span></a>
  <div class="product-category" translate="no"><%= p.category_name %></div><h3 translate="no"><a href="/products/<%= p.slug %>"><%= p.name %></a></h3><p class="product-description" translate="no"><%= p.description %></p><div class="product-bottom"><strong><%= rupiah(p.price_idr) %></strong><a class="detail-button" href="/products/<%= p.slug %>"><span data-i18n="viewDetail">Lihat Detail</span> <span class="card-arrow" aria-hidden="true"><%- include('arrow',{direction:'right'}) %></span></a></div>
</article>
