<section class="section container contact-section" id="kontak">
  <div class="section-heading">
    <div><h2><span data-i18n="availabilityTitle">Cek ketersediaan suku cadang</span><span class="red-dot">.</span></h2></div>
    <p data-i18n="availabilityBody">Hubungi toko untuk memastikan stok produk yang Anda butuhkan.</p>
  </div>
  <div class="contact-layout">
    <div class="contact-primary">
      <span class="eyebrow" data-i18n="stockLabel">KETERSEDIAAN PRODUK</span>
      <h3><span data-i18n="stockTitleLead">Pastikan</span><br><span data-i18n="stockTitleEnd">stok produk.</span></h3>
      <% if(contact.whatsapp){ %>
        <p translate="no">+<%= contact.whatsapp %></p>
        <a class="button primary" href="<%= whatsapp(contact) %>"><span data-i18n="checkAvailability">Cek Ketersediaan</span><%- include('icon',{name:'chat'}) %></a>
      <% }else{ %>
        <p class="placeholder-text" data-i18n="missingWhatsApp">[Placeholder] Nomor WhatsApp belum diisi oleh pengelola.</p>
      <% } %>
    </div>
    <div class="contact-data">
      <div>
        <span class="eyebrow" data-i18n="address">ALAMAT TOKO</span>
        <p class="preserve-lines" translate="no"><%= contact.address %></p>
        <% if(contact.maps_url){ %><a class="text-link" href="<%= contact.maps_url %>" target="_blank" rel="noopener noreferrer"><span data-i18n="maps">Buka Peta</span><span class="inline-arrow"><%- include('arrow',{direction:'up-right'}) %></span></a><% } %>
      </div>
      <div><span class="eyebrow" data-i18n="hours">JAM OPERASIONAL</span><p class="preserve-lines" translate="no"><%= contact.opening_hours %></p></div>
      <% if(contact.phone||contact.email){ %>
        <div><span class="eyebrow" data-i18n="otherContact">KONTAK LAINNYA</span>
          <% if(contact.phone){ %><a href="tel:+<%= contact.phone %>" translate="no">+<%= contact.phone %></a><% } %>
          <% if(contact.email){ %><a href="mailto:<%= contact.email %>" translate="no"><%= contact.email %></a><% } %>
        </div>
      <% } %>
      <% if(contact.links.length){ %>
        <div><span class="eyebrow" data-i18n="follow">IKUTI KAMI</span><div class="social-links">
          <% for(const link of contact.links){ %><a class="text-link" href="<%= link.url %>" target="_blank" rel="noopener noreferrer" translate="no"><%= link.name %></a><% } %>
        </div></div>
      <% } %>
    </div>
  </div>
</section>
