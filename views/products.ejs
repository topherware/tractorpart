<section class="container catalog-section"><%- include('breadcrumb',{crumbs:[{url:'/',key:'home',label:'Beranda'},{key:'products',label:'Produk'}]}) %><div class="catalog-heading"><div><h1><span data-i18n="products">Produk</span><span class="red-dot">.</span></h1></div><p><span data-i18n="chosenParts">Suku cadang pilihan.</span> <span data-i18n="requiredInfo">Informasi yang Anda perlukan.</span></p></div><%- include('filters') %><div class="results-line"><span><strong><%= total %></strong> <span data-i18n="found">produk ditemukan</span></span><a href="/products" class="text-link"><span data-i18n="reset">Reset Filter</span> <span aria-hidden="true">↺</span></a></div><% if(demo){%><p class="demo-label"><span data-i18n="demoCatalog">DATA DUMMY · Produk dan ilustrasi contoh untuk pengembangan.</span></p><%}%><% if(items.length){ %><div class="product-grid"><% items.forEach(p=>{ %><%- include('card',{p}) %><% }) %></div><% }else{ %><div class="empty-state"><span aria-hidden="true">⌕</span><h2><span data-i18n="notFound">Produk tidak ditemukan</span></h2><p><span data-i18n="tryFilters">Coba kata kunci lain atau ubah pilihan filter Anda.</span></p><a class="button primary" href="/products"><span data-i18n="reset">Reset Filter</span></a></div><% } %><%- include('pagination',{pageNumber:catalogPage}) %></section>
