<section class="container detail-section"><%- include('breadcrumb',{crumbs:[{url:'/',key:'home',label:'Beranda'},{url:'/products',key:'products',label:'Produk'},{label:product.name}]}) %><% if(demo){%><p class="demo-label"><span data-i18n="demoDetail">DATA DUMMY · Informasi produk contoh pengembangan.</span></p><%}%><div class="product-detail"><div class="detail-photo"><img src="/media/<%= product.image_asset_id %>" width="<%= product.image_width %>" height="<%= product.image_height %>" alt="<%= product.name %>"></div><div class="detail-info"><span class="eyebrow" translate="no"><%= product.category_name %></span><h1 translate="no"><%= product.name %></h1><span class="badge <%= product.availability==='available'?'available':'unavailable' %>"><span data-i18n="<%= product.availability==='available'?'available':'unavailable' %>"><%= product.availability==='available'?'Tersedia':'Habis' %></span></span><div class="detail-price"><%= rupiah(product.price_idr) %></div><div class="detail-description"><h2><span data-i18n="productDescription">Deskripsi produk</span></h2><p class="preserve-lines" translate="no"><%= product.description %></p></div><a class="button primary wide" href="<%= whatsapp(contact,product) %>" data-product-name="<%= product.name %>" data-product-url="<%= baseUrl %>/products/<%= product.slug %>"><span data-i18n="<%= product.availability==='available'?'askProduct':'askAvailability' %>"><%= product.availability==='available'?'Tanyakan Produk':'Tanyakan Ketersediaan' %></span> <span class="inline-arrow"><%- include('arrow',{direction:'up-right'}) %></span></a><p class="disclaimer"><span data-i18n="disclaimer">Harga dan status merupakan informasi katalog. Konfirmasi pembelian dilakukan langsung dengan toko.</span></p></div></div></section><% if(related.length){ %><section class="container section related-section"><div class="section-heading"><div><span class="eyebrow"><span data-i18n="sameCategory">DALAM KATEGORI YANG SAMA</span></span><h2><span data-i18n="related">Produk terkait</span><span class="red-dot">.</span></h2></div></div><div class="product-grid"><% related.forEach(p=>{ %><%- include('card',{p}) %><% }) %></div></section><% } %>
