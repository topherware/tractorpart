<a class="text-link back-link" href="<%= adminPath('/admin/products') %>"><span class="back-arrow"><%- include('arrow',{direction:'left'}) %></span><span>Kembali ke daftar produk</span></a><form class="editor-grid product-editor" data-api-form data-dirty action="/api/admin/products<%= product.id?'/'+product.id:'' %>" data-method="<%= product.id?'PUT':'POST' %>" enctype="multipart/form-data"><div class="panel product-information"><div class="form-feedback" role="alert" hidden></div><h2>Informasi produk</h2><p class="panel-description">Draft cukup memerlukan nama. Lengkapi semua kolom untuk menerbitkan.</p><div class="field"><label for="name">Nama barang <span>*</span></label><input id="name" name="name" value="<%= product.name %>" minlength="3" maxlength="150" required><span class="field-error" data-error="name"></span></div><div class="form-row"><div class="field"><label for="price_idr">Harga (Rupiah)</label><input type="number" id="price_idr" name="price_idr" value="<%= product.price_idr||'' %>" min="1" max="999999999999" step="1" placeholder="Contoh: 125000"><span class="field-error" data-error="price_idr"></span></div><div class="field"><label for="availability">Ketersediaan</label><select id="availability" name="availability"><option value="available" <%= product.availability==='available'?'selected':'' %>>Tersedia</option><option value="unavailable" <%= product.availability==='unavailable'?'selected':'' %>>Habis</option></select><span class="field-error" data-error="availability"></span></div></div><div class="field"><div class="label-row"><label for="category_id">Kategori</label><button type="button" class="text-button" data-open-category>+ Tambah Kategori</button></div><select id="category_id" name="category_id"><option value="">Pilih kategori</option><% categories.forEach(c=>{ %><option translate="no" value="<%= c.id %>" <%= product.category_id===c.id?'selected':'' %>><%= c.name %></option><% }) %></select><span class="field-error" data-error="category_id"></span></div><div class="field product-description-field"><label for="description">Deskripsi</label><textarea id="description" name="description" rows="7" maxlength="5000" placeholder="Jelaskan produk, fungsi, dan informasi yang sudah dikonfirmasi."><%= product.description %></textarea><small>Teks biasa. Baris baru akan ditampilkan pada detail produk.</small><span class="field-error" data-error="description"></span></div></div><div><section class="panel photo-panel"><h2>Foto utama</h2><p class="panel-description">Satu foto JPG, PNG, atau WebP. Maksimal 5 MB.</p><div class="upload-preview"><img data-preview <%- product.image_asset_id?'src="/media/'+product.image_asset_id+'"':'hidden' %> alt="Preview foto produk"><span data-preview-empty <%= product.image_asset_id?'hidden':'' %>><%- include('admin-icon',{name:'engine'}) %><small>Belum ada foto</small></span></div><label for="image" class="upload-label">Pilih / Ganti Foto</label><input type="file" id="image" name="image" accept="image/jpeg,image/png,image/webp" data-photo><span class="field-error" data-error="image"></span><small>Foto wajib sebelum produk diterbitkan.</small></section><section class="panel publication-panel"><h2>Publikasi</h2><p>Status saat ini: <span class="badge <%= product.publication_status %>"><%= product.publication_status==='published'?'Published':'Draft' %></span></p><input type="hidden" name="publication_status" value="<%= product.publication_status %>"><div class="stack-actions"><% if(product.publication_status==='published'){ %><button class="button primary" type="submit" data-publication="published">Simpan Perubahan</button><button class="button" type="submit" data-publication="draft">Kembalikan ke Draft</button><% }else{ %><button class="button primary" type="submit" data-publication="published"><span>Terbitkan Produk</span><span class="inline-arrow"><%- include('arrow',{direction:'up-right'}) %></span></button><button class="button" type="submit" data-publication="draft">Simpan Draft</button><% } %><a class="button" href="<%= adminPath('/admin/products') %>">Batal</a></div></section></div></form>
