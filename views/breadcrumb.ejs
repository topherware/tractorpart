<nav class="breadcrumb" aria-label="Jejak navigasi" data-i18n-aria="breadcrumbNavigation">
  <ol>
    <% crumbs.forEach((crumb, index) => { %>
      <li>
        <% if (crumb.url) { %>
          <a href="<%= crumb.url %>" <% if(crumb.key){ %>data-i18n="<%= crumb.key %>"<% }else{ %>translate="no"<% } %>><%= crumb.label %></a>
        <% } else { %>
          <span aria-current="page" <% if(crumb.key){ %>data-i18n="<%= crumb.key %>"<% }else{ %>translate="no"<% } %>><%= crumb.label %></span>
        <% } %>
        <% if (index < crumbs.length - 1) { %><span class="breadcrumb-separator" aria-hidden="true">/</span><% } %>
      </li>
    <% }) %>
  </ol>
</nav>
