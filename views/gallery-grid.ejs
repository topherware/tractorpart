<% if(gallery.length){ %><div class="gallery-grid"><% gallery.forEach((g,i)=>{ %><button class="gallery-card" data-gallery data-index="<%= i %>" data-src="/media/<%= g.image_asset_id %>" data-alt="<%= g.alt_text %>" aria-label="Buka foto galeri <%= i+1 %>"><div><img src="/media/<%= g.image_asset_id %>" width="<%= g.image_width %>" height="<%= g.image_height %>" alt="<%= g.alt_text %>" loading="lazy"><span aria-hidden="true"><%- include('icon',{name:'image'}) %></span></div></button><% }) %></div><% }else{ %><div class="empty-state"><h3><span data-i18n="noPhotos">Belum ada foto</span></h3></div><% } %>
