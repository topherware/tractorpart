<section class="hero" id="home"><div class="hero-copy"><h1><span data-i18n="heroTitle">Suku Cadang Andal</span><br><span data-i18n="heroFor">untuk</span> <span><span data-i18n="heroMachine">Mesin Anda.</span></span></h1><p><span data-i18n="heroIntro">Temukan produk, lihat harga dan ketersediaan, lalu hubungi</span><br class="desktop-break"> <span data-i18n="heroIntroEnd">kami untuk kebutuhan suku cadang Anda.</span></p></div><img class="hero-image" src="/static/images/tractorpart-hero.webp" width="1672" height="941" alt="Traktor merah di lahan terbuka" fetchpriority="high"></section>
<section class="section container" id="produk-terbaru"><div class="section-heading"><div><h2><span data-i18n="latestProducts">Produk terbaru</span><span class="red-dot">.</span></h2></div><p><span data-i18n="chosenParts">Suku cadang pilihan.</span> <span data-i18n="requiredInfo">Informasi yang Anda perlukan.</span></p><a class="text-link" href="/products"><span data-i18n="allProducts">Lihat Semua Produk</span> <%- include('icon',{name:'search'}) %></a></div><% if(demo){%><p class="demo-label"><span data-i18n="demoHome">DATA DUMMY · Contoh katalog pengembangan, bukan penawaran produk asli.</span></p><%}%><% if(products.length){%><div class="product-grid"><% products.forEach(p=>{ %><%- include('card',{p}) %><% }) %></div><% }else{ %><div class="empty-state"><span aria-hidden="true">◇</span><h3><span data-i18n="catalogPending">Katalog sedang disiapkan</span></h3><p><span data-i18n="catalogPendingBody">Produk akan tampil setelah diterbitkan oleh pengelola.</span></p><a class="button" href="<%= whatsapp(contact) %>"><span data-i18n="contactStore">Hubungi Toko</span></a></div><% } %></section>
<section class="about-strip" id="tentang"><div class="container"><div class="section-heading"><div><h2 translate="no"><%= about.title %><span class="red-dot">.</span></h2></div><p translate="no"><%= about.home_summary %></p></div><%- include('about-content') %></div></section>
<section class="section container" id="galeri"><div class="section-heading"><div><h2><span data-i18n="storeGallery">Galeri toko</span><span class="red-dot">.</span></h2></div><p><span data-i18n="galleryIntro">Dokumentasi toko dan produk kami.</span></p></div><%- include('gallery-grid') %></section>
