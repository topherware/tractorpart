<div class="table-scroll" role="region" aria-label="Daftar produk" tabindex="0"><table class="product-table"><thead><tr><th>Produk</th><th>Kategori</th><th>Harga</th><th>Ketersediaan</th><th>Publikasi</th><th>Diperbarui</th><th>Aksi</th></tr></thead><tbody><% products.forEach(p=>{ %><tr><td><div class="table-product"><% if(p.image_asset_id){ %><img src="/media/<%= p.image_asset_id %>" width="48" height="48" alt="<%= p.name %>"><% }else{ %><span class="thumbnail-placeholder" role="img" aria-label="Belum ada foto"><%- include('admin-icon',{name:'engine'}) %></span><% } %><a href="<%= adminPath('/admin/products/') %><%= p.id %>/edit"><span translate="no"><%= p.name %></span></a></div></td><td translate="no"><%= p.category_name||'Belum dipilih' %></td><td><%= rupiah(p.price_idr) %></td><td><span class="badge <%= p.availability==='available'?'available':'unavailable' %>"><%= p.availability==='available'?'Tersedia':'Habis' %></span></td><td><span class="badge <%= p.publication_status==='published'?'published':'draft' %>"><%= p.publication_status==='published'?'Published':'Draft' %></span></td><td class="nowrap"><%= new Date(p.updated_at).toLocaleDateString('id-ID',{day:'numeric',month:'short',year:'numeric'}) %><small><%= new Date(p.updated_at).toLocaleTimeString('id-ID',{hour:'2-digit',minute:'2-digit',timeZone:'Asia/Jakarta'}) %> WIB</small></td><td><div class="row-actions"><a class="mini-button" href="<%= adminPath('/admin/products/') %><%= p.id %>/edit">Edit</a><button class="mini-button danger" data-delete="/api/admin/products/<%= p.id %>" data-name="<%= p.name %>">Hapus</button></div></td></tr><% }) %></tbody></table></div><% if(!products.length){ %><div class="empty-state"><h3>Belum ada produk</h3><p>Tambahkan produk pertama atau ubah filter pencarian.</p></div><% } %>
