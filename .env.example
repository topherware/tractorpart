PORT=3000
BASE_URL=http://localhost:3000
# Kosong untuk SQLite lokal. Produksi wajib diisi dari Supabase > Connect > Transaction pooler.
DATABASE_URL= 
SUPABASE_URL=
# Secret key sb_secret_... ATAU legacy service_role. Jangan gunakan anon/publishable key.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=tractorpart-media
# Opsional: sertifikat CA PEM dari Supabase jika dibutuhkan, newline literal \n.
DATABASE_CA_CERT=
DATA_DIR=./data
BACKUP_DIR=./backups
# Production: set NODE_ENV=production, BASE_URL=https://your-domain, TRUST_PROXY=1 behind one trusted reverse proxy.
NODE_ENV=development
TRUST_PROXY=0
# Only used by the account creation CLI. No default password; do not commit .env.
ADMIN_EMAIL=
ADMIN_PASSWORD=




